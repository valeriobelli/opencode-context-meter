{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-context-meter",
  "version": "0.2.0",
  "description": "OpenCode TUI plugin that shows context window usage in the footer and an estimated category breakdown via /context",
  "keywords": [
    "context",
    "context-window",
    "meter",
    "opencode",
    "opencode-plugin",
    "plugin",
    "tokens",
    "tui"
  ],
  "homepage": "https://github.com/valeriobelli/opencode-context-meter#readme",
  "bugs": {
    "url": "https://github.com/valeriobelli/opencode-context-meter/issues"
  },
  "license": "MIT",
  "author": "Valerio Belli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valeriobelli/opencode-context-meter.git"
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "exit 0",
    "changeset": "changeset",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run fallow",
    "fallow": "fallow --health-baseline .fallow-health.json --baseline-mode identity",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "lefthook install",
    "test": "node --test test/*.check.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@opencode/plugin": "^2.0.29",
    "@opentui/solid": "^0.9.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "fallow": "3.34.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "solid-js": "^1.9.12",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.29",
    "@opentui/solid": ">=0.6.6",
    "solid-js": "^1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": false
    },
    "@opentui/solid": {
      "optional": false
    },
    "solid-js": {
      "optional": false
    }
  },
  "packageManager": "pnpm@12.13.0"
}
